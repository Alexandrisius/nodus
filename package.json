{
  "name": "nodus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test --filter=!@nodus/e2e",
    "test:e2e": "pnpm --filter @nodus/e2e test",
    "lint": "eslint .",
    "live-stack": "node scripts/live-stack.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@nodus/config": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3"
  }
}
