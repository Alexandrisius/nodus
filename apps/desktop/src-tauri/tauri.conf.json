{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodus",
  "version": "1.0.1",
  "identifier": "by.nodus.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: http: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["shell-ui"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nodus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QThFRjA5OUJFQzNGNzcKUldSM1AreWJDZStvcFN4SHpQeUhWWWFyaWN2MEZWREdJbEJoMzJaUWN2RXlFK1lLeWpmK05kclUK",
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["ru-RU"],
        "upgradeCode": "476A5224-ADA9-5566-BAFE-BB0D7E16A03A"
      }
    }
  }
}
