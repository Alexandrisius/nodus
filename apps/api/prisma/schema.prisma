// Схема БД Nodus. Правила — docs/architecture/data-model.md:
// суррогатные UUID PK, created_at/updated_at везде, индексы с первой миграции,
// миграции задним числом не изменяются (только новые).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Transactional outbox + event log (I9). Append-only; пишется только через
/// core EventBus в той же транзакции, что и изменение сущности.
model Event {
  id            String    @id @default(uuid()) @db.Uuid
  /// Имя из каталога событий (api-conventions.md), например `task.created`.
  type          String
  /// Глобальный монотонный порядок события (sequence БД); источник seq
  /// WS-envelope realtime-доставки (#104). Присваивается БД, не клиентом.
  seq           BigInt    @unique @default(autoincrement())
  actorId       String?   @map("actor_id") @db.Uuid
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  /// Минимальный payload (id + ключевые поля).
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  /// NULL = ожидает диспетчеризации поллером outbox.
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  /// Метка realtime-фанута (#104): NULL = ещё не опубликовано в Redis Stream.
  /// Ставит RedisStreamPublisher ПОСЛЕ XADD; выборка `fanout_at IS NULL ORDER
  /// BY seq` не теряет поздно закоммиченное событие, как seq-курсор (аудит
  /// #123): курсор по seq перепрыгнул бы его навсегда. Парциальный индекс —
  /// в миграции (Prisma не выражает partial-индексы).
  fanoutAt      DateTime? @map("fanout_at") @db.Timestamptz()

  /// Горячий путь поллера: WHERE published_at IS NULL ORDER BY created_at.
  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("events")
}

/// Дедупликация обработчиков событий (идемпотентность подписчиков, patterns.md).
model EventDelivery {
  eventId     String   @map("event_id") @db.Uuid
  /// Стабильный id обработчика (имя класса).
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz()

  @@id([eventId, handler])
  @@map("event_deliveries")
}

/// Аудит действий пользователей (I7). Append-only; пишется AuditInterceptor.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  /// Действие в точечной нотации (`task.create`).
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  details    Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// Фичефлаги (I10): не-ядровые модули отключаемы без пересборки.
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  /// Область применения (`global`; таргетинг по пользователям — позже).
  scope     String   @default("global")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("feature_flags")
}

// ===== Модуль directory + auth (issue #3, эпик M2 #18) =====

/// Статус учётной записи. Deactivated = архивация (уволен), вход запрещён,
/// исторические связи (задачи, события) сохраняются.
enum UserStatus {
  active
  deactivated
}

enum Gender {
  male
  female
}

/// Вид орг-единицы: management — управленческая структура (по ней живут БП
/// и задачи), legal — юридическая (трудовая книжка). Эпик M2: структуры
/// расходятся (BIM-отдел юридически в «Группе ГИПов»).
enum OrgUnitKind {
  management
  legal
}

/// Сотрудник (data-model.md: User). password_hash — Argon2id PHC-строка.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  lastName     String     @map("last_name")
  firstName    String     @map("first_name")
  middleName   String?    @map("middle_name")
  /// Отображаемое имя (денормализация ФИО; меняется вместе с ФИО).
  displayName  String     @map("display_name")
  status       UserStatus @default(active)
  avatarUrl    String?    @map("avatar_url")
  /// Аватар сотрудника (#186): файл модуля files — квадратный WebP-дериват;
  /// plain UUID без FK (I3). avatar_url (внешняя ссылка) не используется.
  avatarFileId String?    @map("avatar_file_id") @db.Uuid

  // Орг-связи (справочники по ID, I15)
  /// Прямой руководитель — гибкая связь внутри группы (ГИП ↔ помощник),
  /// без фиктивных отделов (эпик M2).
  managerId         String? @map("manager_id") @db.Uuid
  departmentId      String? @map("department_id") @db.Uuid
  positionId        String? @map("position_id") @db.Uuid
  legalDepartmentId String? @map("legal_department_id") @db.Uuid
  legalPositionId   String? @map("legal_position_id") @db.Uuid

  // Контактный блок карточки
  mobilePhone    String?   @map("mobile_phone")
  city           String?
  /// Кабинет / где находится.
  officeLocation String?   @map("office_location")
  isRemote       Boolean   @default(false) @map("is_remote")
  /// Рабочая ставка (1 = полная).
  workRate       Float?    @map("work_rate")
  gender         Gender?
  birthDate      DateTime? @map("birth_date") @db.Date
  /// Дата приёма на работу.
  hiredAt        DateTime? @map("hired_at") @db.Date
  /// Начало рабочего дня, «HH:mm».
  workdayStart   String?   @map("workday_start")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  manager         User?       @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates    User[]      @relation("UserManager")
  department      Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  position        Position?   @relation("ManagementPosition", fields: [positionId], references: [id], onDelete: SetNull)
  legalDepartment Department? @relation("LegalDepartmentMembers", fields: [legalDepartmentId], references: [id], onDelete: SetNull)
  legalPosition   Position?   @relation("LegalPosition", fields: [legalPositionId], references: [id], onDelete: SetNull)

  roles              UserRole[]
  sessions           Session[]
  headedDepartments  Department[] @relation("DepartmentHead")
  deputiedDepartments Department[] @relation("DepartmentDeputy")

  /// Список сотрудников: фильтр по статусу + детерминированная сортировка курсора.
  @@index([status, lastName, firstName, id])
  @@index([managerId])
  @@index([departmentId])
  @@map("users")
}

/// Подразделение (data-model.md: Department). Дерево по parent_id;
/// руководитель (head) и постоянный заместитель (deputy) — эпик M2.
model Department {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  kind      OrgUnitKind @default(management)
  parentId  String?     @map("parent_id") @db.Uuid
  headId    String?     @map("head_id") @db.Uuid
  deputyId  String?     @map("deputy_id") @db.Uuid
  sortOrder Int         @default(0) @map("sort_order")
  /// Архивация вместо удаления (связи сотрудников и история сохраняются).
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  head     User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  deputy   User?        @relation("DepartmentDeputy", fields: [deputyId], references: [id], onDelete: SetNull)

  members      User[] @relation("DepartmentMembers")
  legalMembers User[] @relation("LegalDepartmentMembers")

  @@index([kind, parentId, sortOrder])
  @@map("departments")
}

/// Должность — плоский справочник; kind: management | legal (эпик M2).
model Position {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  kind      OrgUnitKind @default(management)
  sortOrder Int         @default(0) @map("sort_order")
  isActive  Boolean     @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users      User[] @relation("ManagementPosition")
  legalUsers User[] @relation("LegalPosition")

  @@unique([name, kind])
  @@map("positions")
}

/// Роль RBAC — бизнес-данные (навык auth-route-guards): права собираются
/// администратором из каталога Permission и разворачиваются в JWT при логине.
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  /// Системная роль (seed): не удаляется, код не переименовывается.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Право роли — строка из каталога Permission контрактов.
model RolePermission {
  roleId     String @map("role_id") @db.Uuid
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// Сессия (data-model.md: Session): refresh-токен с ротацией и reuse-detection.
/// Храним хэши текущего и предыдущего refresh-токена: предъявление предыдущего
/// после ротации = компрометация → отзыв всей сессии (подход Auth0).
model Session {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  /// SHA-256 текущего refresh-токена (сам токен — только в httpOnly-cookie).
  refreshTokenHash String @map("refresh_token_hash")
  /// SHA-256 предыдущего токена (grace-окно ротации + reuse-detection).
  previousRefreshTokenHash String? @map("previous_refresh_token_hash")
  userAgent String? @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

// ===== Модуль chat (issue #58, эпик M6) =====

/// Беседа. type/visibility/роли — системные константы (TEXT, не pg enum, I15).
/// Привязки к сущностям других модулей (project/task/letter, author_id, user_*)
/// — plain UUID без FK: связь живёт на уровне приложения и событий (I3).
/// Пару direct-беседы охраняет частичный уникальный индекс
/// (user_min, user_max) WHERE type='direct' + CHECK user_min <= user_max
/// («диалог с собой» разрешён) — ДDL в миграции (Prisma не декларирует).
model Conversation {
  id       String  @id @default(uuid()) @db.Uuid
  /// direct | group | project_channel | task | letter.
  type     String
  title    String?
  description String?
  /// closed | open (null у direct/task/letter).
  visibility String?
  projectId String? @map("project_id") @db.Uuid
  taskId    String? @map("task_id") @db.Uuid
  letterId  String? @map("letter_id") @db.Uuid
  /// Матрица прав беседы: {changeInfo,addMembers,removeMembers,post,manageSettings}
  /// → минимальная роль (owner>admin>member); дефолты — contracts.
  permissions Json
  /// Счётчик порядка сообщений: seq сообщений = last_seq после инкремента
  /// В ТОЙ ЖЕ транзакции отправки. Лок этой строки сериализует вставки беседы
  /// → порядок seq == порядок коммита (глобальный bigserial этого не даёт:
  /// значение выделяется до коммита, конкурентные транзакции коммитятся вне
  /// порядка seq — курсор «всё после N» навсегда пропускает поздние вставки
  /// с меньшим seq; postgres.org/docs/functions-sequence + Sequin).
  lastSeq   BigInt  @default(0) @map("last_seq")
  /// Момент последнего корневого сообщения — ось курсора списка бесед.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz()
  /// Инициатор создания (для direct — кто нашёл/создал).
  createdBy String  @map("created_by") @db.Uuid
  /// Нормализованная пара direct: min/max id участников (равны у «Заметок»).
  userMin String? @map("user_min") @db.Uuid
  userMax String? @map("user_max") @db.Uuid
  /// Аватар беседы (группа/канал, #186): файл модуля files — квадратный
  /// WebP-дериват; plain UUID без FK (I3). null — заглушка из инициалов.
  avatarFileId String? @map("avatar_file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  members ConversationMember[]
  messages Message[]
  pins    ConversationPin[]
  drafts  ConversationDraft[]

  @@index([lastMessageAt(sort: Desc), id])
  @@map("conversations")
}

/// Участие: роль, персональные настройки списка и якорь прочитанности.
/// last_read_seq — watermark (монотонный GREATEST, не откатывается): unread =
/// сообщения с seq > last_read_seq ИЛИ отредактированные после last_read_at.
model ConversationMember {
  conversationId String @map("conversation_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  /// owner | admin | member.
  role     String
  lastReadSeq BigInt @default(0) @map("last_read_seq")
  /// Момент последнего продвижения курсора (для readAt и «правка → непрочитано»).
  lastReadAt  DateTime? @map("last_read_at") @db.Timestamptz()
  pinned   Boolean @default(false)
  muted    Boolean @default(false)
  /// «Посмотреть позже»: гасится своей отправкой/пересылкой (мок-семантика).
  snoozed  Boolean @default(false)
  /// Архив беседы (история сохраняется). Раскрывается активностью (отправка/
  /// пересылка — revealHidden, #103) и открытием из поиска людей (PATCH).
  hidden   Boolean @default(false)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// Сообщение. seq уникален в беседе (порядок/курсор/якорь прочтения).
/// Идемпотентность в БД: unique(author_id, client_message_id); значение —
/// Idempotency-Key запроса (+суффикс «:i» у копий пересылки) — crash-окно
/// между Redis-реплеем и фиксацией закрывает БД (ADR-0005).
model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  seq            BigInt
  authorId       String   @map("author_id") @db.Uuid
  clientMessageId String  @map("client_message_id")
  text           String   @default("")
  replyToId      String?  @map("reply_to_id") @db.Uuid
  /// Замороженный снапшот цитаты {authorId, text, quoteText, attachmentKind}:
  /// правка оригинала снапшот не меняет (вердикт 24.09); удалённость оригинала
  /// (deleted: true) вычисляется при чтении — «удаление сильнее заморозки».
  replySnapshot  Json?    @map("reply_snapshot")
  /// Тред ровно одного уровня: ссылка на корневое сообщение.
  threadRootId   String?  @map("thread_root_id") @db.Uuid
  /// Атрибуция пересылки (источник может быть удалён — переход решает сервис).
  fwdConversationId String? @map("fwd_conversation_id") @db.Uuid
  fwdMessageId      String? @map("fwd_message_id") @db.Uuid
  fwdAuthorId       String? @map("fwd_author_id") @db.Uuid
  fwdThreadRootId   String? @map("fwd_thread_root_id") @db.Uuid
  editedAt     DateTime? @map("edited_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()
  /// Бесследное удаление (нет живых ответов, #163): строка остаётся ради
  /// непрерывности seq, ссылок тредов/цитат/пинов и аудита, но исключается
  /// из всех выдач. false у надгробия (видно как «Сообщение удалено»).
  obliterated  Boolean   @default(false)
  /// «Важное сообщение» (#100, ревизия модели 05.10): пробивается через
  /// mute/DND верхним ярусом; непрочитавшим повторяем пуш каждые 5 минут
  /// до часа (аналитика прочтений — watermark/readBy); действий получателя
  /// не требует (ack-механика выпилена решением владельца 05.10).
  urgent       Boolean   @default(false)
  /// userId упомянутых @Имя — снапшот МОМЕНТА ОТПРАВКИ (#100, канон
  /// Discord/Zulip): правка текста упоминания не добавляет/убирает.
  mentionedUserIds Json?  @map("mentioned_user_ids")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo  Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: Restrict)
  replies  Message[] @relation("MessageReply")
  threadRoot Message?  @relation("ThreadTree", fields: [threadRootId], references: [id], onDelete: Restrict)
  threadReplies Message[] @relation("ThreadTree")
  threadParticipants ThreadParticipant[] @relation("ThreadParticipants")
  reactions    MessageReaction[]
  messagePins  ConversationPin[]
  attachments  MessageAttachment[]
  favorites    Favorite[]

  @@unique([conversationId, seq])
  @@unique([authorId, clientMessageId])
  @@index([conversationId, seq(sort: Desc)])
  @@index([authorId, createdAt])
  @@index([threadRootId])
  @@index([replyToId])
  @@map("messages")
}

/// Реакция (toggle, контракт messageReactionToggleBodySchema): PK исключает
/// дубль своей реакции тем же эмодзи.
model MessageReaction {
  messageId String @map("message_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
  @@map("message_reactions")
}

/// Закреп: одно на сообщение (лента закрепов — GET /pins, свежие первыми).
model ConversationPin {
  conversationId String   @map("conversation_id") @db.Uuid
  messageId      String   @unique @map("message_id") @db.Uuid
  pinnedBy       String   @map("pinned_by") @db.Uuid
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, pinnedAt(sort: Desc)])
  @@map("conversation_pins")
}

/// Черновик: отдельная таблица (не поле участника) — горячая строка
/// last_read_* не пухнет от TOAST-текста. revision монотонно растит сервер
/// (last-write-wins между устройствами); пустой текст = удаление (мок-модель).
model ConversationDraft {
  conversationId String @map("conversation_id") @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  text     String
  revision Int     @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_drafts")
}

/// Участник треда (уведомления треда — только участникам, core-flows поток Д):
/// автор корня | ответивший | наблюдатель. Заполняется с первого ответа;
/// потребитель — трек уведомлений (после M13).
model ThreadParticipant {
  threadRootId String @map("thread_root_id") @db.Uuid
  userId       String @map("user_id") @db.Uuid
  /// author | replier | watcher | mentioned (@-упоминание — тоже наблюдатель,
  /// раунд 3).
  source       String
  /// Watermark трэда (точка «есть новые» на посте, раунд 3): чужие ответы
  /// с seq > lastReadSeq — непрочитанные; двигается квитанцией из треда
  /// (POST /read c threadRootId), GREATEST — не откатывается.
  lastReadSeq  BigInt   @default(0) @map("last_read_seq")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  threadRoot Message @relation("ThreadParticipants", fields: [threadRootId], references: [id], onDelete: Cascade)

  @@id([threadRootId, userId])
  @@index([userId])
  @@map("thread_participants")
}

/// Вложение сообщения (Ф6 — после #57: файлы/MinIO). Загруженное-но-не-
/// отправленное живёт с message_id IS NULL у владельца; привязка при отправке
/// ОДНОРАЗОВАЯ (мок-модель). file_id → сущность модуля files, plain UUID (I3).
model MessageAttachment {
  id         String  @id @default(uuid()) @db.Uuid
  messageId  String? @map("message_id") @db.Uuid
  fileId     String  @map("file_id") @db.Uuid
  /// Кто загрузил (валидация одноразовой привязки).
  ownerId    String  @map("owner_id") @db.Uuid
  name       String
  size       Int
  mime       String
  /// image | file | sticker — явный вид (НЕ выводится из mime; контракт).
  kind       String
  width      Int?
  height     Int?
  /// FileObject серверного превью (WebP-дериват, #150); null — не сгенерировано
  /// (воркер ещё не дошёл / формат не декодируется). Пересылка копирует ссылку.
  thumbFileId String? @map("thumb_file_id") @db.Uuid
  /// Снапшот метаданных стикера (kind='sticker', #143): {packId, packTitle,
  /// packScope, emojis} — заморожен на момент отправки, как reply-цитаты;
  /// удаление пака рендер отправленных сообщений не ломает.
  stickerMeta Json?    @map("sticker_meta")
  sortOrder  Int     @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([ownerId])
  @@map("message_attachments")
}

// ===================== избранное чата (#171, M6) =====================

/// Личная закладка-ссылка на сообщение (#171, «закладка, не копия»):
/// контент живёт в оригинале — правки отражаются, удаление оригинала гасит
/// карточку в надгробие (#163), строки оригинала не удаляются физически.
/// PK (user_id, message_id) = идемпотентность звезды. Метки — ЛИЧНЫЕ
/// эмодзи-реакции (JSONB ["🔑"] ≤ 20, модель Telegram Premium, ревизия
/// 04.10; НЕ справочник: I15 про бизнес-списки).
model Favorite {
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  /// Историческая колонка (контракт note не отдаёт с ревизии 04.10;
  /// удаление — contract-этап по канону prisma-migrations).
  note      String   @default("")
  /// ["🔑"] ≤ 20 — личные эмодзи-метки (чипы поиска витрины «Избранного»).
  labels    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("favorites")
}

// ===================== стикеры чата (#143, M6) =====================

/// Пак стикеров: корпоративный (право sticker.manage, ownerId null) или
/// личный (каждый сотрудник себе). Дистрибуция личных — только «из чата»
/// (получатель ставит пак себе); каталога с поиском нет осознанно.
/// Удаление — soft: пак исчезает из пикеров у всех, отправленные сообщения
/// рендерятся дальше по снапшоту message_attachments.sticker_meta.
model StickerPack {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  /// corporate | personal — системная константа (zod в contracts), не бизнес-справочник.
  scope     String
  /// Владелец личного пака; null для корпоративного.
  ownerId   String?   @map("owner_id") @db.Uuid
  /// Создатель (у корпоративного — админ с правом sticker.manage).
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  stickers        Sticker[]
  installedByUsers UserStickerPack[]

  @@index([ownerId])
  @@map("sticker_packs")
}

/// Стикер пака: файл в модуле files (file_id plain UUID, I3 — паттерн
/// MessageAttachment), эмодзи-привязки 1–3 (поиск/подсказки «эмодзи →
/// стикеры», фаза 2). Формат: WebP/PNG ≤512КБ, WebM/VP9 без звука ≤256КБ
/// (валидация magic bytes на сервере).
model Sticker {
  id        String   @id @default(uuid()) @db.Uuid
  packId    String   @map("pack_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  emojis    String[]
  width     Int?
  height    Int?
  mime      String
  size      Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@map("stickers")
}

/// Пак, установленный пользователю («добавил из чата»). PK (userId, packId)
/// даёт идемпотентность установки. Корпоративные видны всем без установки.
model UserStickerPack {
  userId  String   @map("user_id") @db.Uuid
  packId  String   @map("pack_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at") @db.Timestamptz()

  pack StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@id([userId, packId])
  @@map("user_sticker_packs")
}

// ===================== files (#57, M9 фаза 1) =====================

/// Файл в объектном хранилище (MinIO, ADR-0013): логическая сущность;
/// физические версии — FileVersion (фаза 1 создаёт ровно одну, v1).
/// Право на файл решает модуль-потребитель (chat: message_attachments
/// plain file_id, I3 — без FK между модулями).
model FileObject {
  id        String    @id @default(uuid()) @db.Uuid
  ownerId   String    @map("owner_id") @db.Uuid
  bucket    String
  /// Ключ ТЕКУЩЕЙ версии в бакете (указатель; история — в FileVersion).
  key       String    @unique
  /// Номер текущей версии (указатель на FileObject.versions[N]; растёт при
  /// сохранениях ONLYOFFICE, #138). Миграция 28.09: существующие файлы = v1.
  version   Int       @default(1)
  name      String
  mime      String
  size      Int
  /// pending | clean | infected — гейт отдачи (ADR-0013): infected не
  /// отдаётся никогда (410); pending отдаётся, пока сканера нет (ClamAV —
  /// фаза 2, M14). Карантин — префикс ключа quarantine/, фаза 2.
  scanStatus String   @default("pending") @map("scan_status")
  /// Дериват: FileObject порождён из файла derivedFrom (превью вложений
  /// #150). null — «пользовательский» файл; дериваты исключаются из
  /// выборок «файлов пользователя» и живут вместе с оригиналом (plain UUID,
  /// между модулями без FK, I3).
  derivedFrom String? @map("derived_from") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  versions FileVersion[]
  derivatives FileDerivative[]

  @@index([ownerId])
  @@map("file_objects")
}

/// Производная версия файла из конвейера #139: PDF-копия офисного документа
/// (fallback-просмотр при лежащем движке) и PNG-иконка первой страницы
/// (карточка вложения). Ключ генерации = (fileObject, version): правки
/// ONLYOFFICE создают новую версию → конвейер перегенерирует. Миниатюры
/// изображений — отдельный конвейер чата (#150, WebP), здесь не дублируются.
model FileDerivative {
  id          String   @id @default(uuid()) @db.Uuid
  fileObjectId String  @map("file_object_id") @db.Uuid
  version     Int
  /// pdf | icon (спека #139; thumbnail живёт в конвейере #150).
  kind        String
  /// pending | ready | failed (ретраи очереди — attempts).
  status      String   @default("pending")
  /// Ключ объекта в хранилище (SILO); null, пока не ready.
  key         String?
  size        Int      @default(0)
  mime        String
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@unique([fileObjectId, version, kind])
  @@index([fileObjectId])
  @@map("file_derivatives")
}

/// Физическая версия файла в хранилище: фаза 1 — одна (v1) на каждый upload;
/// таблица с первого дня — версии (перегрузки писем и пр.) не потребуют
/// миграций и смены контрактов.
model FileVersion {
  id          String   @id @default(uuid()) @db.Uuid
  fileObjectId String  @map("file_object_id") @db.Uuid
  /// 1.. — монотонно; уникально в пределах файла.
  version     Int
  key         String
  size        Int
  mime        String
  /// Ключ документа ONLYOFFICE, из которого сохранена версия (#138):
  /// `${fileId}.v{N}` на момент правки — дедуп повторных колбэков
  /// (алфавит ключа DS без двоеточия — см. office-session.service).
  sourceKey   String?  @map("source_key")
  /// lastsave колбэка (мс epoch): повторная доставка того же сохранения
  /// (forcesave → закрытие) не создаёт дубликат-версию.
  sourceLastsave BigInt? @map("source_lastsave")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  fileObject FileObject @relation(fields: [fileObjectId], references: [id], onDelete: Cascade)

  @@unique([fileObjectId, version])
  @@map("file_versions")
}

// ===== Модуль notifications (#100, ADR-0016) =====

/// Приоритет уведомления (ADR-0017): абстрактная шкала важности urgent |
/// high | medium | low, маппинг kind → priority — таблица на бэке.
/// Системная константа (не бизнес-справочник, I15): enum допустим в БД? — нет:
/// TEXT + zod-контракт (канон prisma-migrations: бизнес-значения без ENUM).

/// Журнал уведомлений — источник истины (ADR-0016): каждое уведомление
/// персистентно; WS только будит. seq — bigserial (курсор дельты после
/// reconnect); (event_id, user_id) — дедуп повторной доставки события (D4).
model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  /// Глобальный порядок журнала: курсор дельты `?afterSeq=` (D1/D3).
  seq          BigInt    @unique @default(autoincrement())
  userId       String    @map("user_id") @db.Uuid
  /// urgent | high | medium | low (zod-контракт, ADR-0017).
  priority     String
  /// Механика источника (urgent.message, chat.mention, action.assignment…).
  kind         String
  /// conversation | message | task | letter | workflow.
  sourceType   String    @map("source_type")
  /// Id агрегата источника (переход по клику, группировка строк).
  sourceId     String    @map("source_id") @db.Uuid
  /// seq события-источника в беседе (гашение по watermark прочтения).
  sourceSeq    BigInt    @map("source_seq")
  actorId      String?   @map("actor_id") @db.Uuid
  /// Превью текста (поиск, строка ленты).
  preview      String?
  /// Полный текст важного — тело строки журнала/пуша (только urgent).
  urgentText   String?   @map("urgent_text")
  conversationId String? @map("conversation_id") @db.Uuid
  conversationTitle String? @map("conversation_title")
  messageId    String?  @map("message_id") @db.Uuid
  threadRootId String?  @map("thread_root_id") @db.Uuid
  /// Событие-первоисточник: дедуп (event_id, user_id) = один экземпляр.
  eventId      String    @map("event_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  readAt       DateTime? @map("read_at") @db.Timestamptz()
  /// Ознакомление (СЭД-паттерн): только urgent; отдельный от readAt акт.
  ackAt        DateTime? @map("ack_at") @db.Timestamptz()
  /// Повторы срочного остановлены (прочтение/ответ/реакция/потолок, C2/C3).
  repeatsStoppedAt DateTime? @map("repeats_stopped_at") @db.Timestamptz()

  deliveries   NotificationDelivery[]

  @@unique([eventId, userId])
  @@index([userId, readAt, seq(sort: Desc)])
  @@index([userId, seq(sort: Desc)])
  @@index([sourceId, priority, ackAt])
  @@index([priority, readAt, createdAt])
  @@map("notifications")
}

/// Журнал доставок по каналам (C11/D6): когда и каким каналом доставлено;
/// повторы срочного — строки channel='repeat' с номером попытки.
model NotificationDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  /// ws | repeat (расширяемо: будущие desktop/push-каналы).
  channel        String
  /// 0 — первая доставка; 1..N — попытки повтора.
  attempt        Int      @default(0)
  deliveredAt    DateTime @default(now()) @map("delivered_at") @db.Timestamptz()

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, deliveredAt])
  @@map("notification_deliveries")
}

/// Настройки уведомлений пользователя (DND-расписание; ADR-0016 §3).
model NotificationSetting {
  userId     String   @id @map("user_id") @db.Uuid
  dndEnabled Boolean  @default(false) @map("dnd_enabled")
  /// Окно «не беспокоить», локальное «HH:mm» (подавление на клиенте).
  dndStart   String   @default("22:00") @map("dnd_start")
  dndEnd     String   @default("08:00") @map("dnd_end")

  @@map("notification_settings")
}
