# ============================================================
# Nodus — шаблон окружения. Скопируйте в .env и заполните значения:
#   cp .env.example .env
# .env не коммитится; секреты — только здесь, не в документации.
# ============================================================

# --- Порты на хосте (меняйте при конфликте с другими проектами: docker ps) ---
NODUS_WEB_PORT=3000
NODUS_API_PORT=3001
NODUS_GATEWAY_PORT=3002
NODUS_POSTGRES_PORT=5432
NODUS_REDIS_PORT=6379
NODUS_MINIO_API_PORT=9000
NODUS_MINIO_CONSOLE_PORT=9001
NODUS_GOTENBERG_PORT=3100

# --- PostgreSQL ---
POSTGRES_USER=nodus
POSTGRES_PASSWORD=замените-на-свой-пароль
POSTGRES_DB=nodus
# Prisma CLI на хосте (миграции из `pnpm --filter @nodus/api db:migrate`);
# пароль — тот же, что POSTGRES_PASSWORD. В docker api получает свой DATABASE_URL из compose.
DATABASE_URL=postgresql://nodus:замените-на-свой-пароль@localhost:5432/nodus

# --- Redis (pnpm dev и интеграционные тесты на хосте) ---
REDIS_URL=redis://localhost:6379

# --- Auth (issue #3): секрет подписи access-JWT, >= 32 символа (сгенерируйте случайную строку)
JWT_SECRET=сгенерируйте-случайную-строку-32-символа

# Пароли сидинга демо-данных (prisma db seed); по умолчанию Nodus!Admin2026 / Nodus!Demo2026
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# --- MinIO (S3) ---
MINIO_ROOT_USER=nodus
# Минимум 8 символов (требование MinIO)
MINIO_ROOT_PASSWORD=замените-на-случайный-пароль

# --- Cloudflare Tunnel к nodus.by (только профиль `tunnel`, ADR-0002) ---
# Токен — из Cloudflare Zero Trust → Networks → Tunnels (runbook: docs/runbooks/repo-bootstrap.md).
# Плейсхолдер непустой, чтобы `docker compose config` проходил без включённого туннеля.
NODUS_TUNNEL_TOKEN=заполните-токен-туннеля

# --- Локальная разработка вне Docker (pnpm dev) ---
# Порт dev-сервера Vite
NODUS_WEB_DEV_PORT=5173
# MSW-режим (ADR-0001): фронт на моках без бэкенда (концепт, демо руководству)
VITE_API_MOCK=false

# --- Демо-сборка web в Docker (nodus.by) ---
# true — концепт на моках (пока модули бэка не готовы); false — боевой режим с API
NODUS_WEB_MOCK=true
