# ============================================================
# Nodus — шаблон окружения. Скопируйте в .env и заполните значения:
#   cp .env.example .env
# .env не коммитится; секреты — только здесь, не в документации.
# ============================================================

# --- Порты на хосте (меняйте при конфликте с другими проектами: docker ps) ---
NODUS_WEB_PORT=3000
NODUS_API_PORT=3001
NODUS_GATEWAY_PORT=3002
NODUS_POSTGRES_PORT=5432
NODUS_REDIS_PORT=6379
NODUS_MINIO_API_PORT=9000
NODUS_MINIO_CONSOLE_PORT=9001
# Все порты, кроме NODUS_WEB_PORT, compose публикует на 127.0.0.1 (аудит #123);
# gotenberg опубликованного порта не имеет вовсе (потребителей нет).

# --- PostgreSQL ---
POSTGRES_USER=nodus
POSTGRES_PASSWORD=замените-на-свой-пароль
POSTGRES_DB=nodus
# Prisma CLI на хосте (миграции из `pnpm --filter @nodus/api db:migrate`);
# пароль — тот же, что POSTGRES_PASSWORD. В docker api получает свой DATABASE_URL из compose.
DATABASE_URL=postgresql://nodus:замените-на-свой-пароль@localhost:5432/nodus

# --- Redis (docker и pnpm dev/интеграционные тесты на хосте) ---
# Пароль redis-server --requirepass (compose); подставьте тем же значением в REDIS_URL.
REDIS_PASSWORD=замените-на-случайный-пароль
REDIS_URL=redis://:замените-на-случайный-пароль@localhost:6379

# --- Auth (issue #3): секрет подписи access-JWT, >= 32 символа (сгенерируйте случайную строку)
JWT_SECRET=сгенерируйте-случайную-строку-32-символа

# --- API ---
# Общий IP-rate-limit, запросов/мин (дефолт приложения и compose — 3000).
# Нагрузочные прогоны k6 идут с одного IP и поднимают планку; НЕ забывайте
# возвращать дефолт после прогонов (забытый оверрайд = отключённый лимит, аудит #123).
# RATE_LIMIT_MAX=3000

# Пароли сидинга демо-данных (prisma db seed); по умолчанию Nodus!Admin2026 / Nodus!Demo2026
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=

# --- S3-хранилище (SILO — поддерживаемый форк MinIO, silo.pigsty.io) ---
MINIO_ROOT_USER=nodus
# Минимум 8 символов (требование движка)
MINIO_ROOT_PASSWORD=замените-на-случайный-пароль

# --- Файловое хранилище (#57, ADR-0013) ---
# Имя бакета вложений (создаёт minio-init при старте стека).
STORAGE_BUCKET=nodus-files
# Сервисная учётка api в хранилище (права только на объекты; создаёт minio-init).
# Для запуска вне Docker (pnpm dev) — те же значения, что в контейнере.
STORAGE_ACCESS_KEY=nodus-api
# Минимум 8 символов (требование движка).
STORAGE_SECRET_KEY=замените-на-случайный-пароль
# Секрет подписи ссылок отдачи файлов (HMAC; >= 32 символов, отличайте от JWT_SECRET).
STORAGE_URL_SECRET=сгенерируйте-случайную-строку-32-символа

# --- Cloudflare Tunnel к nodus.by (только профиль `tunnel`, ADR-0002) ---
# Токен — из Cloudflare Zero Trust → Networks → Tunnels (runbook: docs/runbooks/repo-bootstrap.md).
# Плейсхолдер непустой, чтобы `docker compose config` проходил без включённого туннеля.
NODUS_TUNNEL_TOKEN=заполните-токен-туннеля

# --- Локальная разработка вне Docker (pnpm dev) ---
# Порт dev-сервера Vite
NODUS_WEB_DEV_PORT=5173
# MSW-режим (ADR-0001): фронт на моках без бэкенда (концепт, демо руководству)
# Куда dev/preview-сервер проксирует /api (живой api для dev-приёмки; пусто — docker NODUS_API_PORT)
# NODUS_API_DEV_TARGET=http://127.0.0.1:3011
# Куда dev/preview-сервер проксирует /socket.io — WS-gateway чата (#104);
# пусто — хост-порт docker-gateway (NODUS_GATEWAY_PORT). Для dev-gateway на ветке:
# NODUS_GATEWAY_DEV_TARGET=http://127.0.0.1:3012
VITE_API_MOCK=false

# --- Демо-сборка web в Docker (nodus.by) ---
# true — концепт на моках (пока модули бэка не готовы); false — боевой режим с API
NODUS_WEB_MOCK=true

# ONLYOFFICE Docs (#138): движок просмотра вложений. Поднять: docker compose --profile office up -d
NODUS_OFFICE_PORT=3013
OFFICE_ENABLED=false
OFFICE_EDIT_ENABLED=true
# >= 32 символов, общий секрет api и documentserver (пустой только если офис не поднимаете)
OFFICE_JWT_SECRET=

# Gotenberg (#139, конвейер производных): прод-api ходит по docker-сети;
# хост-порт — только для песочницы live-stack (loopback-бинд). Пусто = конвейер выключен.
NODUS_GOTENBERG_PORT=3100
#GOTENBERG_URL=http://gotenberg:3000

