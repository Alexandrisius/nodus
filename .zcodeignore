# --- Зависимости и сборка ---
node_modules/
dist/
build/
out/
*.tsbuildinfo
.turbo/

# --- Окружение и секреты (шаблон .env.example коммитим) ---
.env
.env.*
!.env.example
# Локальные docker-compose override (порты/пути разработчика) — не коммитим
docker-compose.override.yml
docker-compose.*.local.yml

# --- Генерируемое (I: не коммитим Prisma client и OpenAPI) ---
**/generated/
apps/api/src/generated/

# --- Тесты и отчёты ---
coverage/
playwright-report/
test-results/
k6-results/

# --- Логи ---
*.log
logs/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# --- Временное ---
tmp/
temp/
*.tmp

tests/e2e/shots/
tests/e2e/shots-*/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
__pycache__/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
